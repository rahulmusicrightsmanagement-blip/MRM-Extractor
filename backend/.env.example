# ─────────────────────────────────────────────────────────────
# MRM Extractor — Backend environment variables
# Copy to .env and fill in real values. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Apple Music ──
# JWT developer token from the Apple Music API.
APPLE_DEVELOPER_TOKEN=

# ── Spotify ──
# Client ID + secret from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── MongoDB ──
# Atlas connection string. MONGO_DB is the database name.
MONGO_URI=
MONGO_DB=mrm_extractor

# ── Auth ──
# Random long string used to sign JWTs (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Super-admin seeded on first startup if it doesn't exist.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Google Drive (OAuth, user-owned) ──
# Folder ID where extracted Excel files are uploaded.
GDRIVE_FOLDER_ID=
# OAuth Desktop/Web client credentials + a long-lived refresh token.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# ── Email (weekly digest, Gmail SMTP) ──
# Sender Gmail address + a 16-char App Password (not the account password).
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# ── Server / deployment ──
# Comma-separated frontend origins allowed by CORS, e.g.
#   https://extractor.yoursite.com,https://www.extractor.yoursite.com
# Leave empty for local dev (defaults to "*").
ALLOWED_ORIGINS=
# Container host/port. Keep 0.0.0.0 for Coolify/Docker. Coolify sets PORT for you.
HOST=0.0.0.0
PORT=8000
