# ─────────────────────────────────────────────────────────────
# MRM Extractor — Frontend environment variables (Vite)
# Vite only exposes vars prefixed with VITE_. Read at BUILD time.
# Copy to .env for local dev, or set in Coolify build env for prod.
# ─────────────────────────────────────────────────────────────

# Public URL of the backend API (no trailing slash).
# Local dev:  http://127.0.0.1:8000
# Production: https://api.your-extractor-domain.com
VITE_API_URL=http://127.0.0.1:8000
